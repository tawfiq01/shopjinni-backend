APP_NAME=ShopJinni
APP_ENV=production
# Leave blank, then on the server run: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.shopjinne.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Create this database (and a matching MySQL user) from cPanel > MySQL(R)
# Databases, then fill in the real name/user/password cPanel assigns —
# cPanel prefixes both with your account username, e.g. cpuser_mobishop.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@shopjinne.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# The Flutter frontend's public_html domain — NOT this API's own domain.
FRONTEND_URL=https://shopjinne.com

# Browser-facing origins allowed to call this API. Add https://www.shopjinne.com
# too (comma-separated) if the www version also resolves.
CORS_ALLOWED_ORIGINS=https://shopjinne.com

# Only needed if the Google Drive backup / Google sign-in features are used.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI="${APP_URL}/backup/google-callback"
